<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Nguyên Lâm | HR Style Life</title>

  <meta
    name="description"
    content="Premium personal portfolio website for an IT Recruiter & Talent Partner in Japan."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#f6f8fc;
      --bg2:#ffffff;
      --card:rgba(255,255,255,0.78);
      --line:rgba(15,23,42,0.08);
      --text:#111827;
      --muted:#64748b;
      --glow:#4f8cff;
      --soft:#1a1d26;
    }

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:'Inter',sans-serif;
      background: radial-gradient(circle at top, #eef4ff 0%, #f7f9fc 45%, #ffffff 100%);
      color:var(--text);
      overflow-x:hidden;
      line-height:1.7;
    }

    body::before{
      content:"";
      position:fixed;
      width:500px;
      height:500px;
      background:rgba(79,140,255,0.12);
      filter:blur(120px);
      top:-150px;
      right:-100px;
      z-index:-1;
    }

    body::after{
      content:"";
      position:fixed;
      width:400px;
      height:400px;
      background:rgba(255,255,255,0.72);
      filter:blur(120px);
      bottom:-120px;
      left:-120px;
      z-index:-1;
    }

    section{
      padding:120px 8%;
      position:relative;
    }

    .section-title{
      font-size:clamp(2rem,5vw,4rem);
      font-weight:600;
      margin-bottom:20px;
      letter-spacing:-2px;
    }

    .section-sub{
      max-width:760px;
      color:var(--muted);
      font-size:1.05rem;
      margin-bottom:60px;
    }

    nav{
      position:fixed;
      top:0;
      width:100%;
      padding:22px 8%;
      z-index:1000;
      backdrop-filter:blur(18px);
      background:rgba(255,255,255,0.72);
      border-bottom:1px solid rgba(15,23,42,0.06);
    }

    .nav-inner{
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .logo{
      font-weight:600;
      letter-spacing:2px;
      font-size:0.9rem;
      text-transform:uppercase;
    }

    .nav-links{
      display:flex;
      gap:28px;
    }

    .nav-links a{
      color:var(--muted);
      text-decoration:none;
      font-size:0.95rem;
      transition:0.3s;
    }

    .nav-links a:hover{
      color:var(--text);
    }

    .hero{
      min-height:100vh;
      display:flex;
      align-items:center;
      position:relative;
      overflow:hidden;
    }

    .hero-content{
      max-width:900px;
      z-index:2;
    }

    .hero-tag{
      color:#89a7ff;
      font-size:0.9rem;
      letter-spacing:3px;
      margin-bottom:24px;
      text-transform:uppercase;
    }

    .hero h1{
      font-size:clamp(3rem,8vw,7rem);
      line-height:1;
      letter-spacing:-5px;
      margin-bottom:30px;
      font-weight:700;
    }

    .hero p{
      font-size:1.2rem;
      color:var(--muted);
      max-width:700px;
    }

    .glow{
      color:white;
      text-shadow:
      0 0 12px rgba(79,140,255,0.35),
      0 0 30px rgba(79,140,255,0.18);
    }

    .scroll-indicator{
      position:absolute;
      bottom:40px;
      left:50%;
      transform:translateX(-50%);
      color:var(--muted);
      font-size:0.85rem;
      letter-spacing:2px;
      animation:float 2s infinite;
    }

    @keyframes float{
      0%,100%{transform:translate(-50%,0);}
      50%{transform:translate(-50%,10px);}
    }

    .particles span{
      position:absolute;
      width:4px;
      height:4px;
      background:rgba(79,140,255,0.55);
      border-radius:50%;
      animation:particle 8s linear infinite;
    }

    @keyframes particle{
      0%{
        transform:translateY(0px);
        opacity:0;
      }
      20%{
        opacity:1;
      }
      100%{
        transform:translateY(-1000px);
        opacity:0;
      }
    }

    .about-grid{
      display:grid;
      grid-template-columns:1.2fr 1fr;
      gap:80px;
      align-items:center;
    }

    .glass{
      background:var(--card);
      border:1px solid var(--line);
      backdrop-filter:blur(20px);
      border-radius:28px;
      padding:40px;
      transition:0.4s ease;
    }

    .glass:hover{
      transform:translateY(-6px);
      border-color:rgba(61,126,255,0.3);
      box-shadow:0 10px 40px rgba(79,140,255,0.10);
    }

    .about-text{
      color:#334155;
      font-size:1.02rem;
    }

    .about-text strong{
      color:white;
      font-weight:600;
    }

    .filter-bar{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-bottom:40px;
    }

    .filter-btn{
      background:rgba(255,255,255,0.72);
      border:1px solid rgba(255,255,255,0.08);
      color:var(--muted);
      padding:10px 18px;
      border-radius:999px;
      cursor:pointer;
      transition:0.3s;
    }

    .filter-btn:hover,
    .filter-btn.active{
      background:rgba(79,140,255,0.12);
      border-color:rgba(61,126,255,0.4);
      color:white;
    }

    .jobs-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
      gap:24px;
    }

    .job-card{
      position:relative;
      overflow:hidden;
      border-radius:24px;
      padding:30px;
      background:rgba(255,255,255,0.72);
      border:1px solid rgba(255,255,255,0.06);
      transition:0.4s ease;
    }

    .job-card:hover{
      transform:translateY(-10px);
      border-color:rgba(61,126,255,0.35);
      box-shadow:0 14px 45px rgba(79,140,255,0.12);
    }

    .job-title{
      font-size:1.3rem;
      font-weight:600;
      margin-bottom:18px;
    }

    .job-meta{
      display:flex;
      flex-direction:column;
      gap:10px;
      color:var(--muted);
      font-size:0.95rem;
    }

    .why-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
      gap:22px;
    }

    .why-card{
      padding:30px;
      border-radius:24px;
      background:rgba(255,255,255,0.68);
      border:1px solid rgba(255,255,255,0.06);
      transition:0.3s;
    }

    .why-card:hover{
      transform:translateY(-6px);
      border-color:rgba(61,126,255,0.35);
    }

    .timeline{
      margin-top:60px;
      border-left:1px solid rgba(255,255,255,0.1);
      padding-left:30px;
      display:flex;
      flex-direction:column;
      gap:40px;
    }

    .timeline-item{
      position:relative;
    }

    .timeline-item::before{
      content:"";
      position:absolute;
      left:-37px;
      top:6px;
      width:14px;
      height:14px;
      border-radius:50%;
      background:var(--glow);
      box-shadow:0 0 20px rgba(61,126,255,0.8);
    }

    .counter-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
      gap:24px;
      margin-top:60px;
    }

    .counter{
      text-align:center;
      padding:30px;
      border-radius:24px;
      background:rgba(255,255,255,0.68);
      border:1px solid rgba(255,255,255,0.06);
    }

    .counter h2{
      font-size:3rem;
      margin-bottom:10px;
    }

    .floating-keywords{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:50px;
    }

    .floating-keywords span{
      padding:12px 18px;
      border-radius:999px;
      background:rgba(255,255,255,0.72);
      border:1px solid rgba(255,255,255,0.08);
      color:#334155;
      animation:floating 4s ease-in-out infinite;
    }

    @keyframes floating{
      0%,100%{transform:translateY(0px);}
      50%{transform:translateY(-8px);}
    }

    .testimonials{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:24px;
    }

    .testimonial{
      border-radius:28px;
      padding:32px;
      background:rgba(255,255,255,0.72);
      border:1px solid rgba(255,255,255,0.06);
      backdrop-filter:blur(20px);
    }

    .contact-box{
      max-width:760px;
      margin:auto;
      text-align:center;
    }

    .contact-links{
      display:flex;
      justify-content:center;
      gap:24px;
      flex-wrap:wrap;
      margin:40px 0;
    }

    .contact-links a{
      color:#1e293b;
      text-decoration:none;
    }

    .cta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:18px 34px;
      border-radius:999px;
      background:linear-gradient(135deg, rgba(61,126,255,0.22), rgba(255,255,255,0.06));
      border:1px solid rgba(61,126,255,0.35);
      color:white;
      text-decoration:none;
      transition:0.4s;
      font-weight:600;
    }

    footer{
      padding:40px;
      text-align:center;
      color:#8d93a1;
      border-top:1px solid rgba(255,255,255,0.06);
      background:rgba(255,255,255,0.7);
    }

    @media(max-width:900px){
      .nav-links{display:none;}
      .about-grid{grid-template-columns:1fr;}
      section{padding:100px 7%;}
    }
  </style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <div class="logo">HR Style Life</div>

    <div class="nav-links">
      <a href="#about">About</a>
      <a href="#jobs">Opportunities</a>
      <a href="#why">Why Me</a>
      <a href="#contact">Contact</a>
    </div>
  </div>
</nav>

<section class="hero">
  <div class="hero-content">
    <div class="hero-tag">
      IT Recruiter / Talent Partner / Japan
    </div>

    <h1>
      Connecting People,
      <span class="glow">Technology</span>
      & Future.
    </h1>

    <p>
      HR Style Life — where recruitment becomes human connection.
    </p>
  </div>

  <div class="scroll-indicator">
    SCROLL
  </div>
</section>

<section id="about">
  <h2 class="section-title">About Me</h2>

  <p class="section-sub">
    Human-centered recruiting with a premium and modern approach inspired by Japanese tech culture.
  </p>

  <div class="about-grid">

    <div class="glass about-text">
      <p>
        Thank you for visiting my profile!<br><br>

        My name is <strong>Nguyên Lâm</strong> (nickname <strong>Ramu</strong>) from Vietnam,
        with around 6 years of experience in IT recruitment for Japanese and Vietnamese markets.
        <br><br>

        I specialize in sourcing talent for:
        <strong>SE / BrSE / AI / SAP / Salesforce</strong> and other IT roles.
        <br><br>

        Currently, I work at <strong>Rikkei Japan</strong>,
        a company that provides high-quality IT services and staffing solutions
        for Japanese and international clients.
        <br><br>

        Through hiring for a wide range of IT positions — especially within
        retail, logistics, and finance industries —
        I support professionals in building and advancing their careers.
        <br><br>

        If you’re interested in exploring opportunities at Rikkei Japan,
        please feel free to contact me:
        <strong>nguyenlt@rikkeisoft.com</strong>
      </p>
    </div>

    <div class="glass">
      <h3 style="font-size:1.8rem; margin-bottom:20px;">
        Human × Technology
      </h3>

      <p style="color:var(--muted);">
        Recruitment is more than filling positions.
        <br><br>
        It is about understanding people, cultures,
        ambitions, and timing.
        <br><br>
        I aim to create meaningful connections between talented professionals
        and innovative companies in Japan’s evolving IT market.
      </p>
    </div>
  </div>
</section>

<section id="jobs">
  <h2 class="section-title">Featured Opportunities</h2>

  <div class="jobs-grid">

    <div class="job-card">
      <div class="job-title">SE (Java/C#/PHP/AWS)</div>
      <div class="job-meta">
        <span>Tokyo / Osaka / Nagoya / Kobe / Fukuoka / Sapporo</span>
        <span>3+ years</span>
        <span>JLPT N2</span>
        <span>4M – 6M JPY</span>
      </div>
    </div>

    <div class="job-card">
      <div class="job-title">BrSE</div>
      <div class="job-meta">
        <span>Tokyo / Osaka / Nagoya / Kobe / Fukuoka / Sapporo</span>
        <span>3+ years</span>
        <span>JLPT N2</span>
        <span>5M – 7M JPY</span>
      </div>
    </div>

    <div class="job-card">
      <div class="job-title">AI Engineer</div>
      <div class="job-meta">
        <span>Tokyo / Kobe</span>
        <span>3+ years</span>
        <span>JLPT N2</span>
        <span>5M – 9M JPY</span>
      </div>
    </div>

  </div>
</section>

<section id="contact">
  <div class="contact-box">

    <h2 class="section-title">
      Let’s Build Your Career in Japan
    </h2>

    <div class="contact-links">
      <a href="mailto:nguyenlt@rikkeisoft.com">
        nguyenlt@rikkeisoft.com
      </a>

      <a href="#">LinkedIn</a>
    </div>

    <a href="mailto:nguyenlt@rikkeisoft.com" class="cta">
      Let’s Build Your Career in Japan
    </a>
  </div>
</section>

<footer>
  HR Style Life © 2026
</footer>

<script>
  const glow = document.createElement("div");

  glow.style.position = "fixed";
  glow.style.width = "300px";
  glow.style.height = "300px";
  glow.style.borderRadius = "50%";
  glow.style.pointerEvents = "none";
  glow.style.background = "radial-gradient(circle, rgba(79,140,255,0.15), transparent 70%)";

  glow.style.transform = "translate(-50%, -50%)";
  glow.style.zIndex = "0";
  glow.style.mixBlendMode = "screen";

  document.body.appendChild(glow);

  document.addEventListener("mousemove", (e) => {
    glow.style.left = e.clientX + "px";
    glow.style.top = e.clientY + "px";
  });
</script>

</body>
</html>
